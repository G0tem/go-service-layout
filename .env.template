# App
APP_NAME=my-app-layout
APP_VERSION=v0.1.0

# settings JWT
JWT_SECRET=secret-code
JWT_TTL=15m

# Logger
LOGGER_LEVEL=trace
LOGGER_PRETTY_CONSOLE=false

# Postgres
POSTGRES_USER=login
POSTGRES_PASSWORD=pass
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_DB_NAME=db-name

# Kafka writer
KAFKA_WRITER_ADDR=kafka:9094
KAFKA_WRITER_TOPIC=apple-topic

# Kafka reader
KAFKA_READER_ADDR=kafka:9094
KAFKA_READER_GROUP=apple-group
KAFKA_READER_TOPIC=apple-topic

# Redis
REDIS_ADDR=redis:6379

# OTEL
OTEL_ENDPOINT=tempo:4317
OTEL_NAMESPACE=dev
OTEL_INSTANCE_ID=pod_id
OTEL_RATIO=1

# Health checker
HEALTHCHECK_URL=http://app:8080/api/v1/healthz
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_FAILURE_THRESHOLD=3

# Ratelimit
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_ENABLED=true

# settings docker
MONGO_HOST=mongo-db
MONGO_PORT=27017
MONGO_USER=mongodb
MONGO_PASSWORD=mongodb

MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=password

POSTGRES_USER=login
POSTGRES_PASSWORD=pass
POSTGRES_DB=db-name

PGADMIN_EMAIL=admin@gmail.com
PGADMIN_PASSWORD=admin